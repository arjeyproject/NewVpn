# ===== NewVpn environment (never commit real .env) =====

# --- Database (set inside docker-compose; adjust only for external DB) ---
POSTGRES_DB=newvpn
POSTGRES_USER=newvpn
POSTGRES_PASSWORD=change_me

# --- Telegram ---
# Token from @BotFather (required to start the bot)
BOT_TOKEN=
# Comma-separated numeric admin IDs (bot /start shows your ID)
ADMIN_TELEGRAM_IDS=

# --- Security ---
# Fernet key for encrypting Cloudflare tokens & proxy credentials
# install.sh generates this automatically
ENCRYPTION_KEY=

# --- Server ---
# Public IP; auto-detected by install.sh when empty
SERVER_PUBLIC_IP=

# --- Subscription API ---
SUB_API_PORT=8080
# e.g. https://vpn.example.com once a domain is attached; empty = http://SERVER_IP:8080
SUBSCRIPTION_BASE_URL=

# --- VPN backend (Xray) ---
XRAY_REALITY_PORT=443
XRAY_WS_PORT=8080
XRAY_TROJAN_PORT=8443
XRAY_CHAIN_PORT_BASE=20000
XRAY_CHAIN_PORT_END=20050
REALITY_DEST=www.samsung.com:443
REALITY_SERVER_NAME=www.samsung.com

# --- Provisioning ---
CONFIGS_PER_PROFILE=6
CONFIG_EXPIRY_DAYS=30

# --- IP scanner ---
IP_SCAN_CRON=0 3,15 * * *
IP_SCAN_SAMPLE_PER_RANGE=40
IP_SCAN_CONCURRENCY=200
IP_SCAN_TIMEOUT=3.0

# --- Misc ---
LOG_LEVEL=INFO
TZ=Asia/Tehran
